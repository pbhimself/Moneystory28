# Supabase project URL, for example https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon public key. Never use a service-role key in the app.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Enable the native Android SMS detector in internal APK builds only.
EXPO_PUBLIC_ENABLE_SMS_DETECTION=false

# development, preview, or production
EXPO_PUBLIC_APP_ENV=development
